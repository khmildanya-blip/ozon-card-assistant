# Yandex Cloud API
# Получить ключ: https://console.cloud.yandex.ru/
# Создать сервисный аккаунт с ролью ai.languageModels.user
YANDEX_API_KEY=AQVN_ВСТАВЬ_СЮДА_СВОЙ_КЛЮЧ
YANDEX_FOLDER_ID=b1g_ВСТАВЬ_СЮДА_ID_КАТАЛОГА

# Путь к тестовому изображению
IMAGE_PATH=img.png

#для рага
VSEGPT_API_KEY=твой_ключ_от_VseGPT
OZON_CLIENT_ID=твой_Client-Id_из_Ozon
OZON_API_KEY=твой_Api-Key_из_Ozon

# Для локального запуска отдельный MySQL не нужен: используется SQLite-файл.
# Для MySQL укажите полный URL, например:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ozon_cards
DATABASE_URL=sqlite:///./ozon_cards.db
#ключ для JWT-токенов
SECRET_KEY=случайная-строка-мин-32-символа
